# Copy to .env and adjust. Every variable is prefixed with USI_ (Upset Sale Intel).

# development | test | production
USI_APP_ENV=development

# SQLite (default, local) or PostgreSQL, e.g. postgresql+psycopg://usi:usi@localhost:5432/usi
USI_DATABASE_URL=sqlite:///./data/app.db

# Fernet master key used to encrypt stored API keys/secrets at rest.
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In development a key is generated automatically into backend/data/.master_key.
USI_MASTER_KEY=

# local  = single-user desktop mode (implicit admin user, no login)
# token  = multi-user mode; create users with `python -m app.cli create-user`
USI_AUTH_MODE=local

# Identifying User-Agent for permitted automated requests to public sources.
USI_HTTP_USER_AGENT=UpsetSaleIntel/1.0 (property research; operator contact: you@example.com)

# Daily tax-status refresh (America/New_York by default)
USI_DAILY_REFRESH_HOUR=6
USI_DAILY_REFRESH_MINUTE=0
USI_TIMEZONE=America/New_York

# Run the background worker inside the API process (handy for a single-process local run)
USI_RUN_WORKER_IN_API=false

# Demo mode enables the clearly-labelled SANDBOX valuation provider and fixture-backed demo data.
USI_DEMO_MODE=false

# Optional OCR (image-only PDF pages). Path to tesseract.exe if not on PATH.
USI_TESSERACT_CMD=

# Hosted demo: when USI_SITE_PASSWORD is set (with USI_AUTH_MODE=local), the browser asks for this username/password
# before showing anything. /api/health stays open for health checks.
USI_SITE_USERNAME=demo
USI_SITE_PASSWORD=

# Load the anonymized demo projects at start-up (used by scripts/serve.py and the Docker image)
USI_SEED_DEMO=false
